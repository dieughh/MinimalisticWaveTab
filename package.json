{
  "name": "minimalistic-wave-tab",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Минималистичный вид новой вкладки «Моя волна».",
  "scripts": {
    "dev": "node ./scripts/dev-build.mjs",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "build:modules": "node ./scripts/module-compile.mjs",
    "format": "oxfmt .",
    "sync": "node ./scripts/sync-addon.mjs",
    "build:sync": "node ./node_modules/vite/bin/vite.js build && node ./scripts/sync-addon.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && node ./node_modules/vite/bin/vite.js build && node ./scripts/test-addon.mjs"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@pulsesync/addon-sdk": "0.17.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "happy-dom": "^21.0.4",
    "oxfmt": "0.74.0",
    "react": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
